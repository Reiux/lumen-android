    <string name="breaker_sign_in_required_button">Masuk kembali</string>

    <string name="breaker_restricted_title">Akun Dibatasi</string>
    <string name="breaker_restricted_msg">Google telah membatasi akun ini. Pencadangan dihentikan. Periksa akun Google Anda secara langsung; jangan terus mencoba lagi.</string>
    <string name="breaker_restricted_button">Hapus akun</string>

    <string name="breaker_rate_limited_title">Batas Kecepatan Tercapai</string>

    <!-- Account Risk & Safety Strings -->
    <string name="account_risk_title">Perhatian</string>
    <string name="account_risk_body">Lumen adalah aplikasi tidak resmi dan mungkin melanggar Ketentuan Layanan Google. Google dapat membatasi atau menonaktifkan akun, yang juga dapat mengunci Anda dari Gmail dan Drive. Gunakan akun cadangan yang aman, dan selalu simpan foto asli Anda.</string>
